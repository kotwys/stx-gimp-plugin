#: file-stx/stx-export-dialog.c:82
msgid ""
"WARNING: A palette of at most 256 colors will be created for the texture "
"which may result in some loss of quality."
msgstr ""
"ВНИМАНИЕ: Для текстуры будет создана палитра из 256 цветов или менее, что "
"может привести к некоторой потере качества."

#: file-stx/stx-export.c:57
msgid "Could not initialize quantization"
msgstr "Не удалось инициализировать квантизацию"

#: file-stx/stx-export.c:71
msgid "Could not generate a palette"
msgstr "Не удалось сгенерировать палитру"

#: file-stx/stx-export.c:154
msgid "Could not create an STX document"
msgstr "Не удалось создать документ STX"

#: file-stx/stx-export.c:163
msgid "Could not write the STX document"
msgstr "Не удалось записать документ STX"

#: file-stx/stx-load.c:86
#, c-format
msgid "Error loading STX file: %s"
msgstr "Ошибка при загрузке файла STX: %s"

#: file-stx/stx.c:37
msgid "PC (BGRA)"
msgstr "PC (BGRA)"

#: file-stx/stx.c:38
msgid "PlayStation® 2 (indexed)"
msgstr "PlayStation® 2 (индексированные цвета)"

#: file-stx/stx.c:118
msgid "Loads Sparkplug textures"
msgstr "Загружает текстуры Sparkplug"

#: file-stx/stx.c:119
msgid ""
"Loads files in the Sparkplug texture format. For PS2, the unswizzling code "
"from ReverseBox is used."
msgstr ""
"Загружает файлы в формате текстур Sparkplug. Для PS2 используется "
"unswizzling-алгоритм из ReverseBox."

#: file-stx/stx.c:134
msgid "Exports Sparkplug textures"
msgstr "Экспортирует текстуры Sparkplug"

#: file-stx/stx.c:135
msgid ""
"Exports images as standalone Sparkplug texture files (STX). For PS2, uses "
"libimagequant for color quantization and the swizzling code from ReverseBox."
msgstr ""
"Экспортирует изображения как отдельные файлы текстур Sparkplug (STX). Для "
"PS2 применяется квантование цвета с помощью libimagequant и "
"swizzling-алгоритм из ReverseBox."

